# Client-visible endpoint URL; this is not a secret. Set it before building the Android app.
VITE_CHAT_API_URL=https://your-server.example.com/api/chat

# Server-only configuration for a custom OpenAI-compatible API.
PORT=3001
LLM_API_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=your-model-name
LLM_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost,capacitor://localhost
